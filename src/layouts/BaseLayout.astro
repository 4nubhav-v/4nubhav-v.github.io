---
import "../styles/global.css";
import NavigationAstroComponent from "../components/Navigation.astro";
import FooterAstroComponent from "../components/Footer.astro";
const { pageTitle } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="dark:selection:bg-gruvbox-dark-orange-bright dark:selection:text-gruvbox-dark-bg0 selection:bg-gruvbox-light-orange-bright selection:text-gruvbox-light-bg0"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="google-adsense-account" content="ca-pub-4316246787906478" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon_io/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon_io/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon_io/favicon-16x16.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MKGH22WNF2"
    ></script></head
  >
  <!-- Google tag (gtag.js) -->

  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", "G-MKGH22WNF2");
  </script>

  <body>
    <NavigationAstroComponent />
    <slot />
    <FooterAstroComponent />
  </body>
</html>
