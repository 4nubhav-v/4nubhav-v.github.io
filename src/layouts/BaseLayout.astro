---
import '../styles/global.css'
import NavigationAstroComponent from '../components/Navigation.astro'
import FooterAstroComponent from '../components/Footer.astro'
const { pageTitle } = Astro.props
---
<!doctype html>
<html lang="en" class="dark:selection:bg-gruvbox-dark-orange-bright dark:selection:text-gruvbox-dark-bg0 selection:bg-gruvbox-light-orange-bright selection:text-gruvbox-light-bg0">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<NavigationAstroComponent />
		<slot/>
		<FooterAstroComponent/>
	</body>
</html>